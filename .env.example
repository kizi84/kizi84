# Database (SQLite by default; switch provider in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# Session signing secret - CHANGE THIS to a long random string in production
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-characters"

# First admin account created by the seed script
ADMIN_EMAIL="admin@uzunov90.com"
ADMIN_PASSWORD="admin123"

# Public site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL="https://uzunov90.com"
UPLOAD_DIR="./uploads"
